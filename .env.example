# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — it is gitignored.

NODE_ENV=development
PORT=3000

# Local Postgres started via `docker compose up -d` (see docker-compose.yml).
# In production (Neon): DATABASE_URL is the pooled connection (pgbouncer=true),
# DIRECT_URL is the direct connection used only for `prisma migrate deploy`.
DATABASE_URL="postgresql://lavenet:lavenet@localhost:5433/lavenet?schema=public"
DIRECT_URL="postgresql://lavenet:lavenet@localhost:5433/lavenet?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-with-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="replace-with-a-different-random-64-char-hex-string"

# Origin allowed to call the API with credentials (CORS). The local Angular
# dev server by default.
CORS_ORIGIN="http://localhost:4200"
