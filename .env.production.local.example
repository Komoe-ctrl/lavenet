# Copy this file to `.env.production.local` and fill in the Neon
# **production** branch connection string. Used only by `pnpm db:seed:prod`
# — never merge these values into `.env` (development). This file is
# gitignored (see .gitignore's `.env.*.local` pattern).

# Pooled or direct both work here — the seed script does a handful of
# one-off queries, not migrations. DIRECT_URL isn't needed: only the API
# runtime and `prisma migrate deploy` (run by Render at deploy time, see
# render.yaml) use it.
DATABASE_URL="postgresql://REPLACE_WITH_PROD_NEON_CONNECTION_STRING"
