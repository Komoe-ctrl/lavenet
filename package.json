  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prepare": "husky",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "test:e2e": "nx run-many -t e2e",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node -r @swc-node/register prisma/seed.ts",
    "db:studio": "prisma studio",
    "api:client:spec": "node tools/scripts/generate-openapi-spec.js",
    "api:client:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:client": "pnpm api:client:spec && pnpm api:client:generate",
    "api:client:check": "pnpm api:client && git diff --exit-code -- apps/web/src/app/core/api-client"
  },
  "private": true,
