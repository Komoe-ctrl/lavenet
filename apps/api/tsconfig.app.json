{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    // Needed because src imports libs/shared/* via the @lavenet/* path
    // alias: without an explicit rootDir, tsc infers one from apps/api
    // alone and rejects those cross-package files (TS6059) once outDir is
    // set. This project isn't part of a TS project-reference graph (see
    // tsconfig.base.json — composite mode was removed, it broke the
    // @nx/angular:application generator), so each app/lib is typechecked
    // as an independent tsc invocation instead.
    "rootDir": "../..",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
