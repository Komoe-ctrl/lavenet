generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in `prisma.config.ts` (CLI) and are passed
// as a driver adapter to `new PrismaClient({ adapter })` at runtime (see
// apps/api/src/prisma/prisma.service.ts) — no `url`/`directUrl` here.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  STAFF
  COURIER
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  role            UserRole  @default(CLIENT)
  // Nullable even though F-AUTH-01/05 require it at registration/profile
  // edit: rows created before this field existed (the seeded demo accounts)
  // predate it and can't be backfilled with a real value.
  fullName        String?
  email           String?   @unique
  phone           String    @unique
  phoneVerifiedAt DateTime?
  passwordHash    String
  // Default true/true: F-AUTH-05 lets a user opt out per channel, but
  // nothing about registration asks them to opt in explicitly.
  notifyEmail     Boolean   @default(true)
  notifySms       Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  addresses     Address[]
  orders        Order[]

  @@index([role])
  @@map("users")
}

enum OtpPurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
}

// Generic across both uses (F-AUTH-02 phone verification, F-AUTH-04
// password reset) rather than two separate tables -- same shape, same
// TTL/attempt/hash rules either way (CLAUDE.md §4 rule 7).
model OtpCode {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Soft delete only (deletedAt), never a block-on-referenced-order rule --
// see docs/ADR/0005-address-deletion-policy.md. `details` (repère /
// indication) is required, not optional: most Abidjan addresses have no
// street number, it's the field that actually gets a courier to the door.
model Address {
  id        String    @id @default(cuid())
  userId    String
  label     String
  commune   String
  quartier  String
  details   String
  geoLat    Float?
  geoLng    Float?
  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

enum ServiceUnit {
  PIECE
  KG
}

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id              String      @id @default(cuid())
  categoryId      String
  slug            String      @unique
  name            String
  unit            ServiceUnit
  processingHours Int
  // isActive: temporarily unavailable (still exists, hidden from the public
  // catalog). deletedAt: soft delete per CLAUDE.md §4 rule 8, excluded from
  // exports/stats too — the two are independent, both required.
  isActive        Boolean     @default(true)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  priceRules PriceRule[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model ArticleType {
  id        String   @id @default(cuid())
  // Stable identity for idempotent catalog seeding (prisma/seed-catalog.ts
  // upserts by slug) — distinct from `name`, which is the display label and
  // free to be edited later without breaking re-seeding.
  slug      String   @unique
  name      String
  iconKey   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceRules PriceRule[]
  orderItems OrderItem[]

  @@map("article_types")
}

// Historized price grid: a row is never overwritten when a price changes —
// a new row is inserted with its own effectiveFrom, and the previous row's
// effectiveTo is closed. `resolveActivePriceRule` (libs/shared/domain)
// picks the one active for a given date from the full row set, the same
// function the checkout of lot 3 will use to snapshot OrderItem.unitPriceXof.
model PriceRule {
  id            String    @id @default(cuid())
  serviceId     String
  articleTypeId String?
  amountXof     Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service     Service      @relation(fields: [serviceId], references: [id])
  articleType ArticleType? @relation(fields: [articleTypeId], references: [id])

  // Best-effort duplicate protection for prisma/seed-catalog.ts's re-seeding:
  // Postgres unique constraints treat NULL as distinct from NULL, so this
  // does NOT catch duplicate base-price rows (articleTypeId null, e.g. KG
  // services) — the seed script's own findFirst-before-create covers that
  // case; this index covers the per-article-type case at the DB level too.
  @@unique([serviceId, articleTypeId, effectiveFrom])
  @@map("price_rules")
}

// Full state machine per CLAUDE.md §4/docs/CAHIER-DES-CHARGES.md §5.4 --
// declared now so `Order.status` is typed correctly from the start, even
// though this lot's increment 1 (cart) only ever writes DRAFT, and only
// PENDING_PICKUP/CANCELLED become reachable once checkout (increment 4)
// lands. Transition enforcement (F-STA) is a separate, later lot.
enum OrderStatus {
  DRAFT
  PENDING_PICKUP
  PICKED_UP
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  ON_HOLD
}

// F-CMD-03: HOME never carries agencyId/agencyDropoffDate; AGENCY always
// does (enforced by the shared zod discriminated union before either ever
// reaches the DB). AGENCY has no TimeSlot/SlotBooking -- no courier is
// mobilized for a client dropping off their own clothes, so it's just a
// plain expected date, not a capacity-limited resource (increment 3 is
// what adds real capacity, for HOME pickup/delivery only).
enum PickupType {
  HOME
  AGENCY
}

// Single row in V1, but a real table (not a config constant) per
// CAHIER-DES-CHARGES.md §5.1 ("le modèle de données doit supporter le
// multi-agences") -- adding a second agency later is a data change, not a
// schema change. name/address/openingHours are demo placeholder content
// (prisma/agency-data.ts), same spirit as the demo catalog prices: this is
// a portfolio project, not a real business with a real address yet.
model Agency {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  address      String
  openingHours String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("agencies")
}

// F-CMD-04. Generic pool: the same TimeSlot can be picked for a pickup or
// a delivery (glossary, CAHIER-DES-CHARGES.md §5.9: "réservable pour un
// retrait ou une livraison") -- no `kind` column. `date` duplicates
// `startsAt`'s calendar date so the picker UI can group/query by day
// without extracting it from a timestamp. `bookedCount` is denormalized
// for cheap availability reads; the only thing that may ever change it is
// a real SlotBooking insert/delete (increment 4) -- never written to
// directly, never the source of truth for capacity (SlotBooking's unique
// constraint is, per CLAUDE.md §4 rule 4). Back-office slot creation
// (F-LIV-01/F-ADM-05) is a separate, later lot -- rows here come from
// prisma/timeslot-data.ts's demo seed for now.
model TimeSlot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  bookedCount Int      @default(0)

  pickupOrders   Order[]       @relation("PickupSlot")
  deliveryOrders Order[]       @relation("DeliverySlot")
  bookings       SlotBooking[]

  @@unique([date, startsAt])
  @@map("time_slots")
}

// Not used until increment 4 (checkout): the table exists from this
// migration on so the checkout transaction only ever has to insert rows,
// never migrate the schema under it. CLAUDE.md §4 rule 4: the unique
// constraint on (slotId, seatIndex) is the actual capacity guarantee -- a
// reservation attempt is an insert, and a unique-violation means the slot
// is full. Nothing in increment 3 writes here yet.
model SlotBooking {
  id        String   @id @default(cuid())
  slotId    String
  seatIndex Int
  orderId   String
  createdAt DateTime @default(now())

  slot TimeSlot @relation(fields: [slotId], references: [id])

  @@unique([slotId, seatIndex])
  @@index([orderId])
  @@map("slot_bookings")
}

// A cart *is* an Order in DRAFT status -- no separate Cart/CartItem table.
// "Add to cart" finds-or-creates a DRAFT order and appends an OrderItem;
// "validate" (checkout, increment 4) is the DRAFT -> PENDING_PICKUP
// transition, in the same transaction that freezes prices, snapshots the
// delivery address and books slots. Everything else this model will need
// (totals, reference, delivery address snapshot) is added by later
// increments' own migrations, not upfront.
model Order {
  id     String      @id @default(cuid())
  userId String
  status OrderStatus @default(DRAFT)

  // F-CMD-03 (increment 2). pickupType is null until the client picks a
  // mode in the checkout tunnel -- there is no default, HOME is not
  // assumed. agencyDropoffDate is a pure calendar date (no time-of-day,
  // @db.Date): the expected date the client will walk in and drop off
  // their own clothes, never a capacity-limited slot.
  pickupType        PickupType?
  agencyId          String?
  agencyDropoffDate DateTime?   @db.Date

  // F-CMD-04 (increment 3). pickupSlotId is only ever set for HOME pickup
  // (AGENCY uses agencyDropoffDate above, no slot); deliverySlotId is
  // always a TimeSlot, regardless of pickup mode -- the finished laundry
  // is always couriered back to the client's address. Storing a
  // *preference* here, not a reservation: no SlotBooking row exists for
  // either until checkout (increment 4) actually books the seat.
  pickupSlotId   String?
  deliverySlotId String?

  // F-CMD-05/07 (increment 4). Everything below is null for the entire time
  // the order is DRAFT and gets its one and only write at checkout, in the
  // same transaction that books the slot seats -- same "frozen, never
  // recomputed" convention as OrderItem.unitPriceXof (CLAUDE.md §4 rule 2).
  //
  // reference: human-readable, unique (CLAUDE.md §4 rule 9), consumed from
  // `order_reference_seq` (raw SQL in this migration, CLAUDE.md §2 exception
  // for slot/sequence reservations) in the checkout transaction. The
  // sequence itself is NOT transactional in Postgres -- a rolled-back
  // checkout burns a number, so this guarantees uniqueness, not
  // gap-freeness. CLAUDE.md §4 rule 5's "no gaps" requirement is scoped to
  // Invoice numbering, not Order.reference.
  //
  // vatRateBps/vatAmountXof: always written (even 0), never left null past
  // checkout -- CLAUDE.md §4 rule 1 ("même à zéro"). See
  // docs/ADR/0007-checkout-vat.md: V1 charges no VAT, but the columns exist
  // so a future non-zero rate needs no migration.
  //
  // deliveryCommune/deliveryQuartier/deliveryDetails/deliveryGeoLat/
  // deliveryGeoLng: copied from deliveryAddressId's Address at checkout, per
  // docs/ADR/0005-address-deletion-policy.md -- deliveryAddressId itself is
  // only ever consulted pre-checkout (like pickupSlotId/deliverySlotId, a
  // preference, not a live source of truth); editing or soft-deleting the
  // original Address afterwards must never change a validated order.
  reference         String? @unique
  subtotalXof       Int?
  discountXof       Int?
  deliveryFeeXof    Int?
  vatRateBps        Int?
  vatAmountXof      Int?
  totalXof          Int?
  deliveryAddressId String?
  deliveryCommune   String?
  deliveryQuartier  String?
  deliveryDetails   String?
  deliveryGeoLat    Float?
  deliveryGeoLng    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency          Agency?     @relation(fields: [agencyId], references: [id])
  pickupSlot      TimeSlot?   @relation("PickupSlot", fields: [pickupSlotId], references: [id])
  deliverySlot    TimeSlot?   @relation("DeliverySlot", fields: [deliverySlotId], references: [id])
  deliveryAddress Address?    @relation(fields: [deliveryAddressId], references: [id])
  items           OrderItem[]

  @@index([userId, status])
  @@index([agencyId])
  @@index([pickupSlotId])
  @@index([deliverySlotId])
  @@index([deliveryAddressId])
  @@map("orders")
}

// unitPriceXof is nullable and stays null for the entire time the parent
// order is DRAFT -- the cart shows a live price, resolved fresh on every
// read via resolveActivePriceRule (libs/shared/domain), never cached here.
// It gets its one and only write at checkout, when the price is genuinely
// frozen (CLAUDE.md §4 rule 2). articleTypeId is nullable for the same
// reason it is on PriceRule: KG services are priced without one.
model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  serviceId     String
  articleTypeId String?
  quantity      Int
  // F-CMD-01: 250 characters max, enforced by the shared zod schema, not
  // repeated here as a DB-level check.
  instructions  String?
  unitPriceXof  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id])
  articleType ArticleType? @relation(fields: [articleTypeId], references: [id])

  @@index([orderId])
  @@map("order_items")
}
